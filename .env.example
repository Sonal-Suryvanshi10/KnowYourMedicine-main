# Backend only: MongoDB Atlas connection string or local MongoDB URI
MONGODB_URI=mongodb://127.0.0.1:27017/knowyourmedicine
SESSION_SECRET=replace-with-at-least-32-random-bytes
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
COOKIE_SAME_SITE=lax

# Optional: first-run admin provision. Use a unique strong password; never commit .env
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Vite reads this value, but it is only a public API URL (never a secret)
VITE_API_BASE_URL=/api

# Backend-only Google Gemini settings. Never use VITE_ for the API key.
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional one-time MySQL import source; configure only while running the importer
# LEGACY_MYSQL_URL=mysql://username:password@127.0.0.1:3306/medicine_db
